{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["workarounds:nodeDockerVersioning"],
  "enabledManagers": [
    "github-actions",
    "dockerfile",
    "custom.regex"
  ],
  "dependencyDashboard": true,
  "timezone": "Europe/Lisbon",
  "minimumReleaseAge": "7 days",
  "customDatasources": {
    "k3sStable": {
      "defaultRegistryUrlTemplate": "https://update.k3s.io/v1-release/channels",
      "format": "json",
      "transformTemplates": [
        "{\"releases\":[{\"version\": $$.(data[id = 'stable'].latest),\"sourceUrl\":\"https://github.com/k3s-io/k3s\",\"changelogUrl\":$join([\"https://github.com/k3s-io/k3s/releases/tag/\",data[id = 'stable'].latest])}],\"homepage\":\"https://k3s.io/\",\"sourceUrl\":\"https://github.com/k3s-io/k3s\"}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["ARG ALPINE_VERSION=(?<currentValue>[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "alpine",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?(?:\\s+extractVersion=(?<extractVersion>\\S+))?\\s+ARG \\w+_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions",
        "dockerfile",
        "custom.regex"
      ],
      "automerge": true,
      "automergeType": "branch",
      "platformAutomerge": false
    },
    {
      "matchDatasources": ["custom.k3sStable"],
      "matchPackageNames": ["k3s-io/k3s"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    },
    {
      "matchPackageNames": [
        "nousresearch/hermes-agent"
      ],
      "schedule": ["* 0-3 * * 0"],
      "automergeSchedule": ["* 0-3 * * 0"],
      "updateNotScheduled": false
    },
    {
      "matchPackageNames": [
        "immanuwell/dockerfile-roast"
      ],
      "minimumReleaseAge": null
    },
    {
      "matchPackageNames": [
        "dhi.io/**"
      ],
      "enabled": false
    }
  ]
}

