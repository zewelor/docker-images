{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["workarounds:nodeDockerVersioning", "github>zewelor/renovate-config//presets/k3s-stable", "github>zewelor/renovate-config//presets/annotations"],
  "enabledManagers": [
    "github-actions",
    "dockerfile",
    "custom.regex"
  ],
  "dependencyDashboard": {
    "enabled": true
  },
  "timezone": "Europe/Lisbon",
  "minimumReleaseAge": "7 days",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["ARG ALPINE_VERSION=(?<currentValue>[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "alpine",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions",
        "dockerfile",
        "custom.regex"
      ],
      "automerge": true,
      "automergeType": "branch",
      "platformAutomerge": false
    },
    {
      "description": "Batch all Codex image dependency updates on the 1st–2nd and 15th–16th of each month",
      "matchFileNames": ["codex/Dockerfile"],
      "groupName": "codex image dependencies",
      "separateMajorMinor": false,
      "schedule": ["* * 1-2,15-16 * *"]
    },
    {
      "matchPackageNames": [
        "nousresearch/hermes-agent"
      ],
      "schedule": ["* * * * 0"],
      "automergeSchedule": ["* * * * 0"],
      "updateNotScheduled": false
    },
    {
      "matchPackageNames": [
        "immanuwell/dockerfile-roast"
      ],
      "minimumReleaseAge": null
    },
    {
      "matchPackageNames": [
        "dhi.io/**"
      ],
      "enabled": false
    }
  ]
}

