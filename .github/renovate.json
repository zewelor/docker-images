{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["workarounds:nodeDockerVersioning", "github>zewelor/renovate-config//presets/k3s-stable", "github>zewelor/renovate-config//presets/github-actions"],
  "enabledManagers": [
    "github-actions",
    "dockerfile",
    "custom.regex"
  ],
  "dependencyDashboard": true,
  "timezone": "Europe/Lisbon",
  "minimumReleaseAge": "7 days",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["ARG ALPINE_VERSION=(?<currentValue>[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "alpine",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?(?:\\s+extractVersion=(?<extractVersion>\\S+))?\\s+ARG \\w+_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions", "dockerfile", "custom.regex"],
      "automergeType": "branch",
      "platformAutomerge": false
    },
    {
      "matchManagers": ["dockerfile", "custom.regex"],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["!action"],
      "automerge": true
    },
    {
      "matchDatasources": ["custom.k3sStable"],
      "matchPackageNames": ["k3s-io/k3s"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    },
    {
      "description": "Batch all Codex image dependency updates on the 1st and 15th of each month",
      "matchFileNames": ["codex/Dockerfile"],
      "groupName": "codex image dependencies",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMajor": false,
      "schedule": ["* * 1,15 * *"]
    },
    {
      "matchPackageNames": [
        "nousresearch/hermes-agent"
      ],
      "schedule": ["* * * * 0"],
      "automergeSchedule": ["* * * * 0"],
      "updateNotScheduled": false
    },
    {
      "matchPackageNames": [
        "immanuwell/dockerfile-roast"
      ],
      "minimumReleaseAge": null
    },
    {
      "matchPackageNames": [
        "dhi.io/**"
      ],
      "enabled": false
    }
  ]
}

